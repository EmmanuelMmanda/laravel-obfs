{
    "name": "mmanda/laravel-obfs",
    "description": "A Simple wrapper for YakPro-po obfuscator for Laravel Framework ",
    "type": "library",
    "require": {
        "php": ">=8.1 <8.6",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "symfony/process": "^6.2|^7.0|^8.0",
        "nikic/php-parser": "^5.9",
        "douglas-fortunatus/yakpro-po": "^3.0"
    },
    "license": "MIT",   
    "autoload": {
        "psr-4": {
            "Mmanda\\LaravelObfs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mmanda\\LaravelObfs\\Providers\\ObfuscateServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Emmanuel-Mmanda",
            "email": "luneya17@gmail.com"
        }
    ],

    "minimum-stability": "stable",
    "prefer-stable": true
}
